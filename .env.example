# CampCalm - exemplo de configuracao local (raiz do repositorio)
# Copie este arquivo para .env e PREENCHA os campos de segredo.
# Nao envie .env para o Git.
NODE_ENV=development
PORT=3000

# PostgreSQL/PostGIS no Docker (acesso da API executada no host)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=campcalm
DATABASE_USER=campcalm
DATABASE_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_LOCAL

# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES

# Chave privada para consulta de enderecos via backend:
# https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Origens autorizadas do frontend Vite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
