{
  "name": "@campcalm/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend do CampCalm, com domínio e casos de uso desacoplados da infraestrutura.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "tsx src/infrastructure/database/check-connection.ts",
    "test:integration": "tsx tests/integration/check-postgres.ts",
    "test:integration:camping-space": "tsx tests/integration/check-camping-space.ts",
    "test:integration:account": "tsx tests/integration/check-account.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.5",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "argon2@0.45.2": true
  }
}
